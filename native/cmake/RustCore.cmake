get_filename_component(OKWW_RUST_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(OKWW_LOCAL_CARGO "${OKWW_RUST_ROOT}/.rust-tools/cargo/bin/cargo.exe")
if(EXISTS "${OKWW_LOCAL_CARGO}")
    set(OKWW_CARGO "${OKWW_LOCAL_CARGO}" CACHE FILEPATH "Cargo executable")
    set(OKWW_RUST_ENV "CARGO_HOME=${OKWW_RUST_ROOT}/.rust-tools/cargo" "RUSTUP_HOME=${OKWW_RUST_ROOT}/.rust-tools/rustup")
else()
    find_program(OKWW_CARGO cargo REQUIRED)
endif()
if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "The current Qt frontend requires the Windows x64 MSVC Rust target.")
endif()
set(OKWW_RUST_TARGET "x86_64-pc-windows-msvc")
set(OKWW_RUST_TARGET_DIR "${CMAKE_BINARY_DIR}/rust-target")
list(APPEND OKWW_RUST_ENV "CARGO_TARGET_DIR=${OKWW_RUST_TARGET_DIR}")
set(OKWW_RUST_LIBRARY "${OKWW_RUST_TARGET_DIR}/${OKWW_RUST_TARGET}/release/okww_core.lib")
file(GLOB_RECURSE OKWW_RUST_SOURCES CONFIGURE_DEPENDS "${OKWW_RUST_ROOT}/native/rust/*.rs" "${OKWW_RUST_ROOT}/native/rust/abi/*.def")
add_custom_command(OUTPUT "${OKWW_RUST_LIBRARY}"
    COMMAND "${CMAKE_COMMAND}" -E env ${OKWW_RUST_ENV} "${OKWW_CARGO}" build --manifest-path "${OKWW_RUST_ROOT}/Cargo.toml" --release --locked --target "${OKWW_RUST_TARGET}"
    DEPENDS ${OKWW_RUST_SOURCES} "${OKWW_RUST_ROOT}/Cargo.toml" "${OKWW_RUST_ROOT}/Cargo.lock" "${OKWW_RUST_ROOT}/rust-toolchain.toml" "${OKWW_RUST_ROOT}/native/rust/Cargo.toml"
    WORKING_DIRECTORY "${OKWW_RUST_ROOT}" VERBATIM)
add_custom_target(okww_rust_build DEPENDS "${OKWW_RUST_LIBRARY}")
add_library(okww_rust_core STATIC IMPORTED GLOBAL)
set_target_properties(okww_rust_core PROPERTIES IMPORTED_LOCATION "${OKWW_RUST_LIBRARY}")
add_dependencies(okww_rust_core okww_rust_build)
add_test(NAME rust_core_tests COMMAND "${CMAKE_COMMAND}" -E env ${OKWW_RUST_ENV} "${OKWW_CARGO}" test --manifest-path "${OKWW_RUST_ROOT}/Cargo.toml" --release --locked --target "${OKWW_RUST_TARGET}")
set_tests_properties(rust_core_tests PROPERTIES WORKING_DIRECTORY "${OKWW_RUST_ROOT}")
